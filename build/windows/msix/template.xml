<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="modhandlergo.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Kabirz\LaserRangeTool">
    </Installer>
    <PackageInformation
        PackageName="LaserRangeTool"
        PackageDisplayName="LaserRangeTool"
        PublisherName="CN=Kabirz"
        PublisherDisplayName="Kabirz"
        Version="0.2.3.0"
        PackageDescription="Laser ranging system PC tool">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.kabirz.laserrangetool"
                Description="Laser ranging system PC tool"
                DisplayName="LaserRangeTool"
                ExecutableName="modhandlergo.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LaserRangeTool</DisplayName>
            <PublisherDisplayName>Kabirz</PublisherDisplayName>
            <Description>Laser ranging system PC tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="modhandlergo.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
